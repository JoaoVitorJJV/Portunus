<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:dashboard="using:Portunus.App.ViewModels.Dashboard"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Portunus.App.Views.Dashboard.EntryEditorView"
             x:DataType="dashboard:EntryEditorViewModel"
             FontFamily="{DynamicResource InterFont}">

  <Border Classes="modal-card" RenderTransformOrigin="0.5,0.4">
    <Border.RenderTransform>
      <ScaleTransform/>
    </Border.RenderTransform>
    <Border.Styles>
      <Style Selector="Border.modal-card">
        <Style.Animations>
          <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
            <KeyFrame Cue="0%">
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="ScaleTransform.ScaleX" Value="0.96"/>
              <Setter Property="ScaleTransform.ScaleY" Value="0.96"/>
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="Opacity" Value="1"/>
              <Setter Property="ScaleTransform.ScaleX" Value="1"/>
              <Setter Property="ScaleTransform.ScaleY" Value="1"/>
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    <!-- ===== ESTILOS BASE DO COMBOBOX ===== -->
      <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </Style>
      
      <!-- Fix para o hover: usando a sua cor correta de hover -->
      <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      </Style>

      <!-- Fix para o foco (borda verde quando clica) idêntico aos inputs -->
      <Style Selector="ComboBox:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      </Style>
      
      <!-- Cor do texto nos itens da lista -->
      <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="4,2"/>
      </Style>
      
      <!-- Fundo quando o item está selecionado (remove o cinza padrão) -->
      <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      </Style>
      <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      </Style>

        <!-- Fix para o hover e foco do CalendarDatePicker -->
      <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      </Style>
      <Style Selector="CalendarDatePicker:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      </Style>
    </Border.Styles>

    <DockPanel>

        <!-- HEADER -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,18,18">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="wm" FontSize="24" Text="{Binding ModalTitle}"/>
          <TextBlock FontSize="12.5" Foreground="{DynamicResource TextDimBrush}" Text="Organize seus itens com tags personalizadas."/>
        </StackPanel>
        <Button Grid.Column="1" Classes="iconbtn" VerticalAlignment="Center"
                Command="{Binding CancelCommand}" ToolTip.Tip="Fechar">
          <i:Icon Value="fa-solid fa-xmark" FontSize="16" Foreground="{DynamicResource TextFaintBrush}"/>
        </Button>
      </Grid>

        <!-- FOOTER -->
      <Border DockPanel.Dock="Bottom" Padding="28,15,28,22"
              BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoftBrush}"
              Background="{DynamicResource Bg2Brush}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button Classes="ghost" MinWidth="120" Command="{Binding CancelCommand}">
             <TextBlock Text="Cancelar" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="primary" MinWidth="152" Command="{Binding CreateCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <!-- Text="Criar categoria" substituído pelo Binding -->
              <TextBlock Text="{Binding PrimaryButtonText}" VerticalAlignment="Center"/>
              <i:Icon Value="fa-solid fa-check" FontSize="15" Foreground="{DynamicResource AccentInkBrush}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- BODY -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="470">
        <StackPanel Margin="28,2,28,22" Spacing="16">

          <!-- Titulo -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="TÍTULO"/>
            <Border Classes="field">
              <DockPanel>
                <i:Icon Value="fa-solid fa-tag" FontSize="17" DockPanel.Dock="Left" Margin="0,0,10,0"
                        VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBox Classes="bare" Watermark="Ex.: GitHub" Text="{Binding Title}"/>
              </DockPanel>
            </Border>
          </StackPanel>
            <!-- Descrição -->
            <StackPanel Spacing="9">
              <TextBlock Classes="lbl" Text="DESCRIÇÃO (OPCIONAL)"/>
              <Border Classes="field" Height="96">
                <DockPanel>
                  <!-- Ícone de texto alinhado ao topo -->
                  <i:Icon Value="fa-solid fa-align-left" FontSize="17" DockPanel.Dock="Left" Margin="0,12,10,0"
                          VerticalAlignment="Top" Foreground="{DynamicResource TextFaintBrush}"/>
      
                  <TextBox Classes="bare" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,10,0,0"
                           Watermark="Breve descrição sobre esta conta…" Text="{Binding Description}"/>
                </DockPanel>
              </Border>
            </StackPanel>

          <!-- Cor do icone -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="COR DO ÍCONE"/>
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Width="46" Height="46" CornerRadius="12" Background="{Binding SelectedBadgeColor}">
                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#64748b">
                  <Border Classes="swatch-dot" Background="#64748b"/></Button>
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#3aa39a">
                  <Border Classes="swatch-dot" Background="#3aa39a"/></Button>
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#2e7d32">
                  <Border Classes="swatch-dot" Background="#2e7d32"/></Button>
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#c48a2b">
                  <Border Classes="swatch-dot" Background="#c48a2b"/></Button>
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#5b8def">
                  <Border Classes="swatch-dot" Background="#5b8def"/></Button>
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#b06fd0">
                  <Border Classes="swatch-dot" Background="#b06fd0"/></Button>
                <Button Classes="swatch" Command="{Binding SelectBadgeColorCommand}" CommandParameter="#d15b6a">
                  <Border Classes="swatch-dot" Background="#d15b6a"/></Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Usuario -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="USUÁRIO OU E-MAIL"/>
            <Border Classes="field">
              <DockPanel>
                <i:Icon Value="fa-solid fa-user" FontSize="17" DockPanel.Dock="Left" Margin="0,0,10,0"
                        VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBox Classes="bare mono" Watermark="voce@exemplo.com" Text="{Binding Username}"/>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- Senha -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="SENHA"/>
            <Border Classes="field">
              <DockPanel>
                <i:Icon Value="fa-solid fa-lock" FontSize="17" DockPanel.Dock="Left" Margin="0,0,10,0"
                        VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                <Button Classes="iconbtn" DockPanel.Dock="Right" Command="{Binding GenerateCommand}" ToolTip.Tip="Gerar senha forte">
                  <i:Icon Value="fa-solid fa-wand-magic-sparkles" FontSize="16" Foreground="{DynamicResource TextFaintBrush}"/>
                </Button>
                <Button Classes="iconbtn" DockPanel.Dock="Right" Command="{Binding ToggleRevealCommand}" ToolTip.Tip="Mostrar/ocultar">
                  <i:Icon Value="{Binding RevealIcon}" FontSize="16" Foreground="{DynamicResource TextFaintBrush}"/>
                </Button>
                <TextBox Classes="bare mono" Text="{Binding Password}"
                         PasswordChar="●" RevealPassword="{Binding IsPasswordRevealed}" Watermark="••••••••••"/>
              </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,1,0,0" IsVisible="{Binding HasPassword}">
              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StrengthBrush}" VerticalAlignment="Center"/>
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{Binding StrengthBrush}" Text="{Binding StrengthLabel}"/>
            </StackPanel>
          </StackPanel>

            <!-- Data para Alterar -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="VALIDADE (OPCIONAL)"/>
            <CalendarDatePicker HorizontalAlignment="Stretch" 
                                Height="46" 
                                CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TextBrush}"
                                Watermark="Sem validade"
                                SelectedDate="{Binding ExpirationDate}">
            </CalendarDatePicker>
          </StackPanel>

          <!-- Site -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="SITE (OPCIONAL)"/>
            <Border Classes="field">
              <DockPanel>
                <i:Icon Value="fa-solid fa-globe" FontSize="17" DockPanel.Dock="Left" Margin="0,0,10,0"
                        VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBox Classes="bare mono" Watermark="https://…" Text="{Binding Url}"/>
              </DockPanel>
            </Border>
          </StackPanel>

        <!-- Cofre -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="COFRE"/>
            <ComboBox HorizontalAlignment="Stretch" 
                      Height="46" 
                      CornerRadius="12"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush2}"
                      BorderThickness="1"
                      PlaceholderText="Selecione o cofre..."
                      PlaceholderForeground="{DynamicResource TextFaintBrush}"
                      ItemsSource="{Binding AvaliableVaults}"
                      SelectedItem="{Binding SelectedVault}">
             <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding VaultName}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Categoria -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="CATEGORIA (OPCIONAL)"/>
            <ComboBox HorizontalAlignment="Stretch" 
                      Height="46" 
                      CornerRadius="12"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush2}"
                      BorderThickness="1"
                      PlaceholderText="Sem categoria"
                      PlaceholderForeground="{DynamicResource TextFaintBrush}"
                      ItemsSource="{Binding AvailableCategories}"
                      SelectedItem="{Binding SelectedCategory}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
            <!-- Códigos de Recuperação -->
          <StackPanel Spacing="9">
            <Grid>
              <TextBlock Classes="lbl" Text="CÓDIGOS DE RECUPERAÇÃO (OPCIONAL)" VerticalAlignment="Center"/>
              <Button Classes="mini" HorizontalAlignment="Right" Command="{Binding AddRecoveryCodeCommand}" ToolTip.Tip="Adicionar código">
                <i:Icon Value="fa-solid fa-plus" FontSize="16" Foreground="{DynamicResource TextFaintBrush}"/>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding RecoveryCodes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Espaçamento entre os códigos gerados -->
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Reutilizamos a classe field para ficar idêntico ao input de usuário/senha -->
                  <Border Classes="field">
                    <DockPanel>
                      <!-- Botão de remover o código -->
                      <Button Classes="mini" DockPanel.Dock="Right" 
                              Command="{Binding DataContext.RemoveRecoveryCodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remover código">
                        <i:Icon Value="fa-solid fa-trash" FontSize="14" Foreground="{DynamicResource TextDimBrush}"/>
                      </Button>
                      
                      <i:Icon Value="fa-solid fa-life-ring" FontSize="16" DockPanel.Dock="Left" 
                              Margin="0,0,10,0" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                      
                      <TextBox Classes="bare mono" Watermark="Ex: A1B2-C3D4" Text="{Binding Code}"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- Notas -->
          <StackPanel Spacing="9">
            <TextBlock Classes="lbl" Text="NOTAS (OPCIONAL)"/>
            <Border Classes="field" Height="96">
              <DockPanel>
                <TextBox Classes="bare" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,10,0,0"
                         Watermark="Anotações sobre esta conta…" Text="{Binding Notes}"/>
              </DockPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</UserControl>
