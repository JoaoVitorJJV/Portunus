<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Portunus.App.ViewModels.Dashboard"
             x:Class="Portunus.App.Views.Dashboard.ConfirmActionView"
             x:DataType="vm:ConfirmActionViewModel">

  <!-- Removemos a classe 'modal-card' e definimos o visual explicitamente para evitar heranças indesejadas -->
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderSoftBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Width="420"
          Padding="28,24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          BoxShadow="0 10 40 0 #50000000">

    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
      
      <TextBlock FontSize="20" FontWeight="Bold" 
                 Foreground="{DynamicResource TextBrush}" 
                 Text="{Binding Title}" 
                 TextAlignment="Left" Margin="0"/>
      
      <TextBlock FontSize="14" 
                 Foreground="{DynamicResource TextDimBrush}" 
                 Text="{Binding Message}" 
                 TextWrapping="Wrap" 
                 TextAlignment="Left" Margin="0"/>
      
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
        <Button Classes="ghost" Command="{Binding CancelCommand}">
           <TextBlock Text="{Binding CancelText}" VerticalAlignment="Center"/>
        </Button>
        <Button Classes="primary" Command="{Binding ConfirmCommand}">
           <TextBlock Text="{Binding ConfirmText}" VerticalAlignment="Center"/>
        </Button>
      </StackPanel>
      
    </StackPanel>
  </Border>
</UserControl>