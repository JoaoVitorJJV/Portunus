<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:i="using:Projektanker.Icons.Avalonia">

	<Styles.Resources>
		<!-- Geometrias de ícone (grade 24×24, mesmas do mockup) -->
		<StreamGeometry x:Key="IconSeal">M12 2l7 3v6c0 4.5-3 8-7 11-4-3-7-6.5-7-11V5l7-3z</StreamGeometry>
		<StreamGeometry x:Key="IconLock">M6 10h12a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M8 10V7a4 4 0 0 1 8 0v3</StreamGeometry>
		<StreamGeometry x:Key="IconHouse">M3 9l9-6 9 6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9z</StreamGeometry>
		<StreamGeometry x:Key="IconEye">M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z</StreamGeometry>
		<StreamGeometry x:Key="IconShieldCheck">M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z M9 12l2 2 4-4</StreamGeometry>
		<StreamGeometry x:Key="IconAlert">M10.3 3.9l-8 13.9A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3.2l-8-13.9a2 2 0 0 0-3.4 0z M12 9v4 M12 17h0.01</StreamGeometry>
		<StreamGeometry x:Key="IconCheck">M20 6L9 17l-5-5</StreamGeometry>
		<StreamGeometry x:Key="IconArrow">M5 12h14M13 6l6 6-6 6</StreamGeometry>
	</Styles.Resources>

	<!-- ===== Tipografia utilitária ===== -->
	<Style Selector="TextBlock.wm">
		<Setter Property="FontFamily" Value="{DynamicResource InterFont}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>
	<Style Selector="TextBlock.sub">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
		<Setter Property="TextAlignment" Value="Center"/>
	</Style>
	<Style Selector="TextBlock.lbl">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
		<Setter Property="LetterSpacing" Value="0.4"/>
	</Style>

	<!-- ===== Selo (logo) ===== -->
	<Style Selector="Border.seal">
		<Setter Property="Width" Value="60"/>
		<Setter Property="Height" Value="60"/>
		<Setter Property="CornerRadius" Value="17"/>
		<Setter Property="Background" Value="{DynamicResource SealBrush}"/>
	</Style>

	<!-- ===== Campo de entrada (.inp) ===== -->
	<Style Selector="Border.field">
		<Setter Property="Height" Value="46"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Padding" Value="14,0"/>
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>
	<Style Selector="Border.field:focus-within">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<!-- TextBox "pelado" pra sentar dentro do Border.field -->
	<Style Selector="TextBox.bare">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
		<Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>
	<Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
	  <Setter Property="Background" Value="Transparent"/>
	  <Setter Property="BorderThickness" Value="0"/>
	</Style>

	<!-- ===== Botão primário (.btn) ===== -->
	<Style Selector="Button.primary">
		<Setter Property="Height" Value="46"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.primary:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
	</Style>
	<Style Selector="Button.primary:disabled /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="Opacity" Value="0.45"/>
	</Style>

	<!-- ===== Botão fantasma (.btn.ghost) ===== -->
	<Style Selector="Button.ghost">
		<Setter Property="Height" Value="46"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>

	<!-- ===== Ícone-botão (olho, etc.) ===== -->
	<Style Selector="Button.iconbtn">
		<Setter Property="Width" Value="30"/>
		<Setter Property="Height" Value="30"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
	</Style>

	<!-- ===== Teclado do PIN ===== -->
	<Style Selector="Button.pin">
		<Setter Property="Width" Value="72"/>
		<Setter Property="Height" Value="60"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="FontSize" Value="22"/>
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.pin:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
	</Style>
	<Style Selector="Button.pin.fn">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
	</Style>

	<!-- ===== Segmento (dev switcher) ===== -->
	<Style Selector="Border.seg">
		<Setter Property="CornerRadius" Value="9"/>
		<Setter Property="Padding" Value="2"/>
		<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>
	<Style Selector="Button.seg">
		<Setter Property="Height" Value="26"/>
		<Setter Property="Padding" Value="11,0"/>
		<Setter Property="CornerRadius" Value="7"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.seg.on">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>

	<!-- ===== Caixas de aviso (.note / .note.warn) ===== -->
	<Style Selector="Border.note">
		<Setter Property="CornerRadius" Value="11"/>
		<Setter Property="Padding" Value="13,11"/>
		<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
	</Style>

		<!-- ===== Toast (pill de notificação) ===== -->
	<Style Selector="Border.toast">
	  <Setter Property="MinHeight" Value="42"/>
	  <Setter Property="Padding" Value="16,11"/>
	  <Setter Property="CornerRadius" Value="11"/>
	  <Setter Property="Background" Value="{DynamicResource TextBrush}"/>
	  <Setter Property="HorizontalAlignment" Value="Right"/>
	  <Setter Property="VerticalAlignment" Value="Bottom"/>
	  <Setter Property="Margin" Value="0,0,24,24"/>
	  <Setter Property="IsHitTestVisible" Value="False"/>
	  <Setter Property="Opacity" Value="0"/>
	  <Setter Property="RenderTransform" Value="translateX(20px)"/>
	  <Setter Property="BoxShadow" Value="0 14 44 0 #40000000"/>
	  <Setter Property="Transitions">
		<Transitions>
		  <DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
		  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
		</Transitions>
	  </Setter>
	</Style>

	<Style Selector="Border.toast.on">
	  <Setter Property="Opacity" Value="1"/>
	  <Setter Property="RenderTransform" Value="translateX(0)"/>
	</Style>

	<Style Selector="Border.toast TextBlock.toast-title">
	  <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
	  <Setter Property="FontSize" Value="13"/>
	  <Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<Style Selector="Border.toast TextBlock.toast-msg">
	  <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
	  <Setter Property="FontSize" Value="12"/>
	  <Setter Property="Opacity" Value="0.7"/>
	  <Setter Property="TextWrapping" Value="Wrap"/>
	</Style>

		<!-- ===== Titlebar / seal pequeno ===== -->
	<Style Selector="Border.seal-sm">
		<Setter Property="Width" Value="28"/>
		<Setter Property="Height" Value="28"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="{DynamicResource SealBrush}"/>
	</Style>
	<Style Selector="TextBlock.wm-sm">
		<Setter Property="FontFamily" Value="{DynamicResource SerifFont}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="18"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>

	<!-- ===== Botão "Novo item" ===== -->
	<Style Selector="Button.new-btn">
		<Setter Property="Height" Value="36"/>
		<Setter Property="Padding" Value="15,0"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.new-btn:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
	</Style>

	<!-- ===== nav-item da sidebar ===== -->
	<Style Selector="Button.nav-item">
		<Setter Property="Padding" Value="11,8"/>
		<Setter Property="CornerRadius" Value="9"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
		<Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>
	<Style Selector="Button.nav-item.active /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>
	<Style Selector="Button.nav-item.active i|Icon">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="Button.nav-item TextBlock.ct">
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- ===== labels de seção / tags ===== -->
	<Style Selector="TextBlock.sec-label">
		<Setter Property="FontSize" Value="10.5"/>
		<Setter Property="LetterSpacing" Value="1"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
		<Setter Property="FontWeight" Value="Bold"/>
	</Style>
	<Style Selector="Button.sec-add">
		<!-- Largura e Altura fixas removidas -->
    
		<!-- Esquerda: 8, Topo: 4, Direita: 0, Base: 4 -->
		<!-- O 0 na direita garante que o ícone encoste perfeitamente na margem igual ao número de baixo -->
		
    
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.tag-row">
		<Setter Property="Padding" Value="11,6"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.tag-row:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
	</Style>

	<!-- ===== card de status (Sentinela) ===== -->
	<Style Selector="Border.vs-card">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="13"/>
		<Setter Property="ClipToBounds" Value="True"/>
	</Style>
	<Style Selector="Button.vs-lock">
		<Setter Property="Height" Value="28"/>
		<Setter Property="Padding" Value="11,0"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.vs-lock:pointerover /template/ ContentPresenter">
		<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>

	<!-- ===== busca da lista ===== -->
	<Style Selector="Border.search">
		<Setter Property="Height" Value="36"/>
		<Setter Property="Padding" Value="12,0"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>
	<Style Selector="Border.search:focus-within">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>

	<!-- ===== grupo / item da lista ===== -->
	<Style Selector="TextBlock.grp">
		<Setter Property="FontSize" Value="10.5"/>
		<Setter Property="LetterSpacing" Value="0.6"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Margin" Value="10,12,10,6"/>
	</Style>
	<Style Selector="Button.item">
		<Setter Property="Padding" Value="11,9"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Background" Value="Transparent"/>
    
		<!-- Mude de Left para Stretch AQUI -->
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.item:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
	</Style>
	<Style Selector="Button.item.sel /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="{DynamicResource SelBgBrush}"/>
	</Style>
	<Style Selector="Button.item.sel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="{DynamicResource SelBgBrush}"/>
	</Style>
	<Style Selector="Button.item TextBlock.item-t">
		<Setter Property="FontSize" Value="13.5"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>
	<Style Selector="Button.item TextBlock.item-s">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
	</Style>
	<Style Selector="Button.item.sel TextBlock.item-t">
	  <Setter Property="Foreground" Value="{DynamicResource SelInkBrush}"/>
	</Style>
	<Style Selector="Button.item.sel TextBlock.item-s">
	  <Setter Property="Foreground" Value="{DynamicResource SelInkBrush}"/>
	  <Setter Property="Opacity" Value="0.72"/>
	</Style>

	<!-- ===== detalhe ===== -->
	<Style Selector="TextBlock.det-title">
		<Setter Property="FontFamily" Value="{DynamicResource SerifFont}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="22"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>
	<Style Selector="Border.cchip">
		<Setter Property="Height" Value="24"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="CornerRadius" Value="7"/>
		<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
	</Style>
	<Style Selector="Border.cchip TextBlock">
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
	</Style>
	<Style Selector="Border.cchip i|Icon">
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
	</Style>
	<Style Selector="Button.abtn">
		<Setter Property="Height" Value="34"/>
		<Setter Property="Padding" Value="14,0"/>
		<Setter Property="CornerRadius" Value="9"/>
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="FontSize" Value="12.5"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.abtn:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
	</Style>
	<Style Selector="Button.abtn.icon">
		<Setter Property="Width" Value="34"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
	</Style>

	<!-- grupo de campos / campo / separador -->
	<Style Selector="Border.fgroup">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Margin" Value="0,0,0,14"/>
		<Setter Property="ClipToBounds" Value="True"/>
	</Style>
	<Style Selector="Grid.field">
		<Setter Property="Margin" Value="16,13"/>
	</Style>
	<Style Selector="Border.field-sep">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
	</Style>
	<Style Selector="TextBlock.flabel">
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="LetterSpacing" Value="0.5"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Margin" Value="0,0,0,3"/>
	</Style>
	<Style Selector="TextBlock.fval">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
		<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
	</Style>
	<Style Selector="Button.mini">
		<Setter Property="Width" Value="30"/>
		<Setter Property="Height" Value="30"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.mini:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
		<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="TextBlock.otp-code">
		<Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="17"/>
		<Setter Property="LetterSpacing" Value="2"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
	</Style>

	<!-- recovery codes -->
	<Style Selector="Border.rec-ct">
		<Setter Property="Padding" Value="7,2"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="{DynamicResource BrassSoftBrush}"/>
	</Style>
	<Style Selector="Border.rec-ct TextBlock">
		<Setter Property="FontSize" Value="10.5"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrassBrush}"/>
	</Style>
	<Style Selector="Button.rec-linkbtn">
		<Setter Property="Height" Value="28"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.rec-linkbtn:pointerover /template/ ContentPresenter">
		<Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="Button.rec-cell">
		<Setter Property="Padding" Value="11,8"/>
		<Setter Property="CornerRadius" Value="9"/>
		<Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.rec-cell:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="Button.rec-cell.used">
		<Setter Property="Opacity" Value="0.45"/>
		<Setter Property="Cursor" Value="Arrow"/>
	</Style>
	<Style Selector="Button.rec-cell TextBlock.rec-code">
		<Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="LetterSpacing" Value="1"/>
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
	</Style>
	<Style Selector="Button.rec-cell.used TextBlock.rec-code">
		<Setter Property="TextDecorations" Value="Strikethrough"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
	</Style>
	<Style Selector="Button.rec-cell TextBlock.rec-n">
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
	</Style>
	<Style Selector="Ellipse.spinner">
	  <Setter Property="Width" Value="20"/>
	  <Setter Property="Height" Value="20"/>
	  <Setter Property="StrokeThickness" Value="3"/>
	  <Setter Property="StrokeDashArray" Value="16,5"/>
	  <Setter Property="StrokeLineCap" Value="Round"/>
	  <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
	  <Setter Property="Stroke" Value="{DynamicResource AccentInkBrush}"/>
	  <Style.Animations>
		<Animation Duration="0:0:1" IterationCount="Infinite">
		  <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
		  <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
		</Animation>
	  </Style.Animations>
	</Style>
	<!-- ============ MODAL (novo) ============ -->

	<!-- backdrop escuro -->
	<Style Selector="Button.modal-backdrop">
	  <Setter Property="Background" Value="#99000000"/>
	  <Setter Property="HorizontalAlignment" Value="Stretch"/>
	  <Setter Property="VerticalAlignment" Value="Stretch"/>
	  <Setter Property="CornerRadius" Value="0"/>
	  <Setter Property="Cursor" Value="Arrow"/>
	</Style>
	<Style Selector="Button.modal-backdrop:pointerover /template/ ContentPresenter">
	  <Setter Property="Background" Value="#99000000"/>
	</Style>

	<!-- card do modal -->
	<Style Selector="Border.modal-card">
	  <Setter Property="Width" Value="650"/>
	  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
	  <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
	  <Setter Property="BorderThickness" Value="1"/>
	  <Setter Property="CornerRadius" Value="16"/>
	  <Setter Property="BoxShadow" Value="0 40 90 -25 #66000000"/>
	  <Setter Property="ClipToBounds" Value="True"/>
	</Style>

	<!-- amostras de cor do badge -->
	<Style Selector="Button.swatch">
	  <Setter Property="Width" Value="30"/>
	  <Setter Property="Height" Value="30"/>
	  <Setter Property="Padding" Value="0"/>
	  <Setter Property="Background" Value="Transparent"/>
	  <Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
	  <Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="Border.swatch-dot">
	  <Setter Property="Width" Value="24"/>
	  <Setter Property="Height" Value="24"/>
	  <Setter Property="CornerRadius" Value="8"/>
	  <Setter Property="BorderThickness" Value="2"/>
	  <Setter Property="BorderBrush" Value="Transparent"/>
	</Style>
	<Style Selector="Button.swatch:pointerover Border.swatch-dot">
	  <Setter Property="BorderBrush" Value="{DynamicResource TextDimBrush}"/>
	</Style>
</Styles>